{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "/home/ayron/Pictures/Fastfetch/samurai.png",
        "width": 18,
        "height": 8,
        "padding": {
            "top": 0,
            "right": 1
        }
    },

    "display": {
        "separator": ">  ",
        "color": {
            "separator": "red"
        },
        "constants": [
            "───────────────────────────────────────────────────────────────────────────",
            "│\u001b[75C│\u001b[75D"
        ]
    },

    "modules": [
        {
            "format": "{#1}{#keys}╭{$1}╮\u001b[76D {user-name-colored}{at-symbol-colored}{host-name-colored} 🖥  ",
            "type": "title"
        },
        {
            "key": "{$2}{#1}󰇄 desktop  ",
            "type": "de"
        },
        {
            "key": "{$2}{#1} term     ",
            "type": "terminal"
        },
        {
            "key": "{$2}{#1} shell    ",
            "type": "shell"
        },
        {
            "key": "{$2}{#1}󰍛 cpu      ",
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "key": "{$2}{#1}󰍛 gpu      ",
            "type": "gpu"
        },
        {
            "key": "{$2}{#1}󰉉 disk     ",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "{$2}{#1} memory   ",
            "type": "memory"
        },
        {
            "format": "{#1}{#keys}╰{$1}╯",
            "type": "custom"
        }
    ]
}
